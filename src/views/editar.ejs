<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movies | Editar Pelicula</title>
</head>
    <body>

        <h1>Editar Película</h1>

        <%if(typeof msg !== 'undefined' && msg){%>
            <p style="color:red"><%- msg%></p>
         <%}%>
         
         <form action="/movies/editmovie/<%= data.id_pelicula %>" method="POST" enctype="multipart/form-data">
                             

            <p><label for="url_imagen">Portada pelicula</label></p>   
                <p><img src="http://localhost:3000/<%= data.url_imagen %>" alt="portada de pelicula <%= data.titulo %>"></p>

            <p><label for="titulo">Titulo</label>
                <input type="text" name="titulo" id="titulo" value="<%= data.titulo %>" placeholder="Titulo de la pelicula"></p>
                
            <p><label for="director">Director</label>
                <input type="text" name="director" id="director" value="<%= data.director %>" placeholder="Director de la pelicula"></p>

            <p><label for="anio">Año</label>
                <input type="text" name="anio" id="anio" value="<%= data.anio %>" placeholder="Año de lanzamiento"></p>

            <p><label for="genero">Genero</label>
                <input type="text" name="genero" id="genero" value="<%= data.genero %>" placeholder="Genero de la pelicula"></p>

            <p><label for="duracion">Duracion</label>
                <input type="text" name="duracion" id="duracion" value="<%= data.duracion %>" placeholder="Duracion de la pelicula"></p>

            <p><label for="url_imagen">Actualizar portada:</label>
                <input type="file" name="url_imagen"></p>
        
                <p><button type="submit">Guardar cambios</button></p>
        </form>

        <form action="/movies/removemovie/<%= data.id_pelicula %>" method="POST" onsubmit="return confirm('¿Seguro que quieres borrar esta película?');">
            <p><input type="submit" value="Borrar pelicula"></p> 
        </form>
            

    </body>
</html>
