<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Movies | Editar Pelicula</title>
        <link rel="stylesheet" href="/css/main.css" />
    </head>
    <body>
        <div class="edit-movie-container">
            <h1 class="edit-movie-title">Editar Película</h1>

            <% if (typeof msg !== 'undefined' && msg) { %>
            <p class="edit-movie-error"><%- msg %></p>
            <% } %>

            <!-- Formulario de edición -->
            <form
                class="edit-movie-form"
                action="/movies/editmovie/<%= data.id_pelicula %>"
                method="POST"
                enctype="multipart/form-data"
                novalidate
            >
                <div class="edit-movie-field">
                    <label>Portada actual</label>
                    <img
                        class="edit-movie-cover"
                        src="http://localhost:3000/<%= data.url_imagen %>"
                        alt="Portada de <%= data.titulo %>"
                    />
                </div>

                <div class="edit-movie-field">
                    <label for="titulo">Titulo</label>
                    <input
                        type="text"
                        name="titulo"
                        id="titulo"
                        value="<%= data.titulo %>"
                        placeholder="Titulo de la pelicula"
                    />
                </div>

                <div class="edit-movie-field">
                    <label for="director">Director</label>
                    <input
                        type="text"
                        name="director"
                        id="director"
                        value="<%= data.director %>"
                        placeholder="Director de la pelicula"
                    />
                </div>

                <div class="edit-movie-field">
                    <label for="anio">Año</label>
                    <input
                        type="text"
                        name="anio"
                        id="anio"
                        value="<%= data.anio %>"
                        placeholder="Año de lanzamiento"
                    />
                </div>

                <div class="edit-movie-field">
                    <label for="genero">Genero</label>
                    <input
                        type="text"
                        name="genero"
                        id="genero"
                        value="<%= data.genero %>"
                        placeholder="Genero de la pelicula"
                    />
                </div>

                <div class="edit-movie-field">
                    <label for="duracion">Duracion</label>
                    <input
                        type="text"
                        name="duracion"
                        id="duracion"
                        value="<%= data.duracion %>"
                        placeholder="Duracion de la pelicula"
                    />
                </div>

                <div class="edit-movie-field">
                    <label for="url_imagen">Actualizar portada</label>
                    <input type="file" name="url_imagen" />
                </div>

                <button type="submit" class="edit-movie-submit">
                    Guardar cambios
                </button>
            </form>

            <!-- Formulario de eliminación -->
            <form
                action="/movies/removemovie/<%= data.id_pelicula %>"
                method="POST"
                onsubmit="return confirm('¿Seguro que quieres borrar esta película?');"
            >
                <button type="submit" class="edit-movie-delete">
                    Borrar pelicula
                </button>
            </form>
        </div>
    </body>
</html>
