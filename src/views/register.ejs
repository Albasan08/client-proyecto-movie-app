<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Register</title>
        <link rel="stylesheet" href="/css/main.css" />
    </head>
    <body>
        <div class="form__wrapper">
            <main class="form__side">
                <form action="/signup" method="post" class="form" novalidate>
                    <div class="form__bienvenida">
                        <h1>¡Crea tu cuenta!</h1>
                        <h2>Regístrate para empezar a guardar tus películas</h2>
                    </div>

                    <div class="form__datos">
                        <label for="nombre">Nombre de Usuario</label>
                        <input
                            type="text"
                            id="nombre"
                            name="nombre"
                            autocomplete="off"
                            placeholder="Tu nombre de usuario"
                            value="<%= typeof nombre !== 'undefined' ? nombre : '' %>"
                            required
                        />
                    </div>

                    <div class="form__datos">
                        <label for="email">Correo Electrónico</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            autocomplete="off"
                            placeholder="tucorreo@ejemplo.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                            required
                        />
                    </div>

                    <div class="form__datos">
                        <label for="password">Contraseña</label>
                        <input
                            id="password"
                            type="password"
                            name="password"
                            placeholder="Tu contraseña"
                            title="Mínimo 6 caracteres"
                            required
                        />
                    </div>

                    <div class="form__datos">
                        <label for="confirmPassword"
                            >Confirmar Contraseña</label
                        >
                        <input
                            id="confirmPassword"
                            type="password"
                            name="confirmPassword"
                            placeholder="Repite tu contraseña"
                            required
                        />
                        <% if (typeof error !== 'undefined') { %>
                        <div class="error-message"><%= error %></div>
                        <% } %>
                    </div>
                    <button class="form__button" type="submit">
                        Crear Cuenta
                    </button>
                    <div class="form__actions">
                        <div class="form__row">
                            <span>¿Ya tienes cuenta?</span>
                            <a href="/" title="Iniciar sesión">
                                Inicia sesión ahora
                            </a>
                        </div>
                    </div>
                </form>
            </main>
            <aside class="info__side"></aside>
        </div>
    </body>
</html>
